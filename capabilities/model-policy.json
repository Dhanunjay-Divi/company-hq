    }
  },
  "supervisor_auto_selection": {
    "low": {
      "tier": "worker",
      "reason": "Do not burn apex allowance on ordinary work."
    },
    "medium": {
      "tier": "expert",
      "reason": "Use stronger reasoning when multiple components or uncertainty are material."
    },
    "high": {
      "tier": "apex",
      "reason": "Reserve apex for architecture, security, migrations, high blast radius or repeated failure."
    }
  },
  "preflight_review": {
    "required_for_build_requests": true,
    "preferred_provider_family": "different-from-planner",
    "low_risk": {
      "tier": "worker",
      "cross_family": "preferred"
    },
    "medium_risk": {
      "tier": "expert",
      "cross_family": "required-when-available"
    },
    "high_risk": {
      "tier": "apex",
      "cross_family": "required-when-available"
