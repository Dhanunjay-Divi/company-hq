{
  "schema": 1,
  "reviewed_on": "2026-09-20",
  "rule": "No permanent global winner. Choose the highest-scoring authorized model for the task family; reserve apex models for hard/high-risk coordination.",
  "tiers": {
    "scout": {
      "purpose": "narrow discovery, extraction, small checks",
      "target_cost": "lowest capable",
      "codex_default": "gpt-5.6-luna"
    },
    "worker": {
      "purpose": "normal implementation",
      "target_cost": "balanced",
      "codex_default": "gpt-5.6-terra"
    },
    "expert": {
      "purpose": "complex implementation, architecture, review",
      "target_cost": "high when justified",
      "codex_default": "gpt-5.6-sol"
    },
    "apex": {
      "purpose": "highest-risk or hardest coordination only",
      "target_cost": "reserved",
      "codex_default": "gpt-6-astra"
    }
  },
