{
  "schema": 1,
  "principles": {
    "lazy_load": true,
    "minimal_team": true,
    "one_task_authority": "ClawTeam",
    "one_orchestrator": "Company HQ",
    "preflight_review_before_spawn": true,
    "cross_family_review_preferred": true,
    "no_full_catalog_prompt_injection": true
  },
  "source_pool": {
    "top_40": "docs/repository-candidates.json",
    "extra": [
      "ruvnet/ruflo",
      "msitarzewski/agency-agents",
      "lamm-mit/scientific-agent-skills",
      "cathrynlavery/diagram-design",
      "calesthio/OpenMontage",
      "DeusData/codebase-memory-mcp",
      "getzep/graphiti",
      "supermemoryai/supermemory"
    ]
  },
  "stack_decisions": [
    {
      "layer": "desktop",
      "primary": "Company HQ + Agent Teams AI UI patterns",
      "disposition": "keep",
      "reason": "Single desktop control surface; do not add a second canonical task board."
    },
    {
      "layer": "orchestration",
      "primary": "Company HQ",
      "secondary": "Ruflo selective capabilities",
      "disposition": "keep-and-expand",
      "reason": "Ruflo contributes goals, intelligence, workflows, cost and observability without becoming a competing scheduler."
    },
    {
      "layer": "code_intelligence",
      "primary": "CodeGraph",
      "secondary": "Serena",
      "optional": [
        "Graphify"
      ],
      "fallbacks": [
        "codebase-memory-mcp",
        "Graft"
      ],
      "disposition": "migrate-preference",
      "reason": "CodeGraph is local, auto-syncing and cross-platform; Serena adds semantic/LSP refactors; Graphify is strongest when docs/media/SQL belong in the graph."
    },
    {
      "layer": "project_memory",
      "primary": "Ruflo scoped memory",
      "optional": [
        "Graphiti",
        "Supermemory"
      ],
      "disposition": "keep",
      "reason": "Avoid duplicate memory stores by default; add temporal/global memory only for a measured gap."
    },
    {
      "layer": "token_output",
      "primary": "RTK",
      "optional": [
        "Headroom"
      ],
      "disposition": "adopt-after-benchmark",
      "reason": "RTK compactly filters noisy tool output without proxying provider auth; Headroom is more aggressive and stays opt-in until matched quality tests pass."
    },
    {
      "layer": "skills",
      "primary": "lazy capability registry",
      "sources": [
        "ECC",
        "wshobson/agents",
        "gstack",
        "Agency Agents",
        "Superpowers",
        "Scientific Agent Skills",
        "Diagram Design",
        "OpenMontage"
      ],
      "disposition": "lazy-load",
      "reason": "Index metadata globally; load only selected role/skill packets for each task."
    },
    {
      "layer": "provider_routing",
      "primary": "native provider runtimes first",
      "optional": [
        "OpenCode"
      ],
      "disposition": "subscription-first",
      "reason": "Preserve account and billing boundaries; use OpenCode for explicitly configured long-tail providers, not as a silent auth/proxy rewrite."
    },
    {
      "layer": "vibe-kanban",
      "primary": "none",
      "disposition": "do-not-adopt",
      "reason": "Upstream is sunsetting; borrow UX ideas only."
    },
    {
      "layer": "cc-switch",
      "primary": "none",
      "disposition": "reference-only",
      "reason": "Useful provider configuration UI, but provider switching/proxying must not become Company HQ's execution authority."
    }
  ],
