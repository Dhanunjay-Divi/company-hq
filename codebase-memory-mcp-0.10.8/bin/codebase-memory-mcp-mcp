#!/bin/sh
set -eu
umask 077

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)
HOME_DIR=${HOME:?HOME is required but is preserved unchanged}
PYTHON=${COMPANY_HQ_PYTHON:-$(command -v python3 || true)}
GUARD="$SCRIPT_DIR/mcp_guard.py"
BINARY="$SCRIPT_DIR/codebase-memory-mcp"

if [ -z "$PYTHON" ] || [ ! -x "$PYTHON" ]; then
  echo "codebase-memory-mcp: python3 is unavailable" >&2
  exit 1
fi
STATE_ROOT=$("$PYTHON" "$REPO_ROOT/scripts/resolve_state_path.py" codebase-memory) || exit $?
if [ ! -f "$GUARD" ] || [ ! -x "$BINARY" ]; then
  echo "codebase-memory-mcp: pinned binary/guard is not installed in this checkout; see INSTALLATION.md" >&2
  exit 1
fi
mkdir -p "$STATE_ROOT/config" "$STATE_ROOT/cache" "$STATE_ROOT/runtime"
chmod 700 "$STATE_ROOT" "$STATE_ROOT/config" "$STATE_ROOT/cache" "$STATE_ROOT/runtime"

exec /usr/bin/env -i \
  PATH=/usr/bin:/bin:/usr/sbin:/sbin \
  LANG=C \
  HOME="$HOME_DIR" \
  USER=${USER:-local} \
  LOGNAME=${LOGNAME:-${USER:-local}} \
  XDG_CONFIG_HOME="$STATE_ROOT/config" \
  CBM_CACHE_DIR="$STATE_ROOT/cache" \
  CBM_RUNTIME_DIR="$STATE_ROOT/runtime" \
  CBM_LOG_LEVEL=warn \
  "$PYTHON" \
  "$GUARD" \
  "$BINARY" \
  --ui=false "$@"
