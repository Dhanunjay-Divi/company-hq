#!/bin/sh
set -eu
umask 077
exec /usr/bin/env -i \
  PATH=/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin \
  LANG=en_US.UTF-8 USER=uno LOGNAME=uno \
  /usr/bin/sandbox-exec \
  -D STATE_ROOT=/Users/uno/.local/share/agent-toolkit/ruflo-integration/state \
  -f /Users/uno/.local/share/agent-toolkit/ruflo-integration/sandbox.sb \
  /opt/homebrew/bin/node \
  /Users/uno/.local/share/agent-toolkit/ruflo-integration/ruflo-memory-mcp.mjs
