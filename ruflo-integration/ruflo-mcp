#!/bin/sh
set -eu
umask 077

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
PYTHON=${COMPANY_HQ_PYTHON:-$(command -v python3 || true)}
NODE=${COMPANY_HQ_NODE:-$(command -v node || true)}
SANDBOX_EXEC=${COMPANY_HQ_SANDBOX_EXEC:-/usr/bin/sandbox-exec}

if [ -z "$PYTHON" ] || [ ! -x "$PYTHON" ]; then
  echo "ruflo-mcp: python3 is unavailable; set COMPANY_HQ_PYTHON" >&2
  exit 1
fi
STATE_ROOT=$("$PYTHON" "$REPO_ROOT/scripts/resolve_state_path.py" ruflo) || exit $?
if [ -z "$NODE" ] || [ ! -x "$NODE" ]; then
  echo "ruflo-mcp: Node.js is unavailable; set COMPANY_HQ_NODE" >&2
  exit 1
fi
if [ ! -x "$SANDBOX_EXEC" ]; then
  echo "ruflo-mcp: macOS sandbox-exec is unavailable; refusing an unsandboxed Ruflo launch" >&2
  exit 1
fi
mkdir -p "$STATE_ROOT"
chmod 700 "$STATE_ROOT"

INSTALL_ROOT="$REPO_ROOT/ruflo-3.41.2"
if [ ! -d "$INSTALL_ROOT" ]; then
  INSTALL_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/agent-toolkit/ruflo-3.41.2"
fi

exec /usr/bin/env -i \
  PATH=/usr/bin:/bin:/usr/sbin:/sbin \
  LANG=${LANG:-C.UTF-8} USER=${USER:-local} LOGNAME=${LOGNAME:-${USER:-local}} \
  RUFLO_INTEGRATION_STATE_ROOT="$STATE_ROOT" \
  RUFLO_INSTALL_ROOT="$INSTALL_ROOT" \
  RUFLO_PROJECT_ROOT="${RUFLO_PROJECT_ROOT:-}" \
  "$SANDBOX_EXEC" \
  -D STATE_ROOT="$STATE_ROOT" \
  -f "$SCRIPT_DIR/sandbox.sb" \
  "$NODE" \
  "$SCRIPT_DIR/ruflo-memory-mcp.mjs"
