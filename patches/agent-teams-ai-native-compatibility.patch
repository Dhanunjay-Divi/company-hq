@@ -6,6 +6,32 @@ export interface CodexSnapshotRefreshOptions {
   forceRefreshToken: boolean;
 }
 
+export const AGENT_TEAMS_CODEX_NATIVE_ACCOUNT_PROFILE_ENV =
+  'AGENT_TEAMS_CODEX_NATIVE_ACCOUNT_PROFILE';
+
+export type CodexNativeAccountProfile = 'legacy-compatible' | 'modern';
+
+export function resolveCodexNativeAccountProfile(
+  env: NodeJS.ProcessEnv = process.env
+): CodexNativeAccountProfile {
+  return env[AGENT_TEAMS_CODEX_NATIVE_ACCOUNT_PROFILE_ENV]?.trim().toLowerCase() === 'modern'
+    ? 'modern'
+    : 'legacy-compatible';
+}
+
+export function shouldMaterializeLegacyCodexAuth(env: NodeJS.ProcessEnv = process.env): boolean {
+  return resolveCodexNativeAccountProfile(env) === 'legacy-compatible';
+}
+
+export function applyCodexNativeAccountProfile(
+  options: CodexSnapshotRefreshOptions,
+  env: NodeJS.ProcessEnv = process.env
+): CodexSnapshotRefreshOptions {
+  return resolveCodexNativeAccountProfile(env) === 'modern'
+    ? { ...options, forceRefreshToken: false }
+    : options;
+}
