diff --git a/test/features/codex-account/main/codexNativeAccountProfile.test.ts b/test/features/codex-account/main/codexNativeAccountProfile.test.ts
new file mode 100644
index 000000000..0d7b47cb0
--- /dev/null
+++ b/test/features/codex-account/main/codexNativeAccountProfile.test.ts
@@ -0,0 +1,43 @@
+import { describe, expect, it } from 'vitest';
+
+import {
+  AGENT_TEAMS_CODEX_NATIVE_ACCOUNT_PROFILE_ENV,
+  applyCodexNativeAccountProfile,
+  resolveCodexNativeAccountProfile,
+  shouldMaterializeLegacyCodexAuth,
+} from '../../../../src/features/codex-account/main/composition/codexSnapshotRefreshOptions';
+
+describe('codexNativeAccountProfile', () => {
+  it('preserves upstream legacy compatibility by default', () => {
+    const env = {};
+
+    expect(resolveCodexNativeAccountProfile(env)).toBe('legacy-compatible');
+    expect(shouldMaterializeLegacyCodexAuth(env)).toBe(true);
+    expect(
+      applyCodexNativeAccountProfile({ includeRateLimits: true, forceRefreshToken: true }, env)
+    ).toEqual({ includeRateLimits: true, forceRefreshToken: true });
+  });
+
+  it('keeps modern native Codex account storage authoritative', () => {
+    const env = { [AGENT_TEAMS_CODEX_NATIVE_ACCOUNT_PROFILE_ENV]: 'modern' };
+
+    expect(resolveCodexNativeAccountProfile(env)).toBe('modern');
+    expect(shouldMaterializeLegacyCodexAuth(env)).toBe(false);
+    expect(
+      applyCodexNativeAccountProfile({ includeRateLimits: true, forceRefreshToken: true }, env)
+    ).toEqual({ includeRateLimits: true, forceRefreshToken: false });
+  });
+
+  it('only enables the modern profile for its explicit value', () => {
+    expect(
+      resolveCodexNativeAccountProfile({
+        [AGENT_TEAMS_CODEX_NATIVE_ACCOUNT_PROFILE_ENV]: ' MODERN ',
+      })
+    ).toBe('modern');
+    expect(
+      resolveCodexNativeAccountProfile({
+        [AGENT_TEAMS_CODEX_NATIVE_ACCOUNT_PROFILE_ENV]: 'disabled',
+      })
+    ).toBe('legacy-compatible');
+  });
+});
