#!/usr/bin/env python3
"""Start or reuse the secure local ClawTeam metadata board."""

from __future__ import annotations

import os
import signal
import socket
import subprocess
import sys
import time
import urllib.request
from urllib.parse import urlparse
from pathlib import Path

ROOT = Path(__file__).resolve().parent
from runtime_config import clawteam_data_dir, python_executable
PYTHON = python_executable()
SERVER = ROOT / "secure_board.py"
STATE = clawteam_data_dir().resolve()
CONTROL = STATE / ".board"
PID_FILE = CONTROL / "pid"
URL_FILE = CONTROL / "url"
LOG_FILE = CONTROL / "server.log"
os.umask(0o077)


def _pid_exists(pid: int) -> bool:
    if os.name == "nt":
        import ctypes
        process_query_limited_information = 0x1000
        handle = ctypes.windll.kernel32.OpenProcess(
            process_query_limited_information, False, pid
        )
        if not handle:
            return False
        ctypes.windll.kernel32.CloseHandle(handle)
        return True
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def tracked() -> tuple[int, str] | None:
    try:
        pid = int(PID_FILE.read_text().strip())
        url = URL_FILE.read_text().strip()
        if not _pid_exists(pid):
            return None
        if os.name != "nt":
            command = subprocess.run(
                ["/bin/ps", "-p", str(pid), "-o", "command="],
                capture_output=True, text=True, check=True,
            ).stdout
            if str(SERVER) not in command:
                return None
        request = urllib.request.Request(url + "/api/overview")
        with urllib.request.urlopen(request, timeout=1) as response:
            if response.status != 200:
                return None
        return pid, url
    except Exception:
        return None


def start() -> int:
    current = tracked()
    if current:
        print(f"ClawTeam metadata board already running: {current[1]}")
        return 0
    CONTROL.mkdir(parents=True, exist_ok=True)
    # Reuse this installation's previous free port so bookmarks survive a
    # normal update. Never take over an address held by another process.
    port = 0
    try:
        previous = urlparse(URL_FILE.read_text().strip())
        if previous.scheme == 'http' and previous.hostname == '127.0.0.1' and previous.port:
            with socket.socket() as probe:
                probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
                probe.bind(('127.0.0.1', previous.port))
            port = previous.port
    except (OSError, ValueError):
        pass
    with LOG_FILE.open("w", encoding="utf-8") as log:
        popen_options = {
            "cwd": ROOT,
            "env": os.environ.copy(),
            "stdin": subprocess.DEVNULL,
            "stdout": log,
            "stderr": log,
        }
        if os.name == "nt":
            popen_options["creationflags"] = subprocess.CREATE_NEW_PROCESS_GROUP
        else:
            popen_options["start_new_session"] = True
        proc = subprocess.Popen(
            [str(PYTHON), str(SERVER), "--port", str(port)],
            **popen_options,
        )
    url = ""
    for _ in range(60):
        if proc.poll() is not None:
            break
        try:
            first = LOG_FILE.read_text(encoding="utf-8").splitlines()[0]
            if first.startswith("ClawTeam metadata board: "):
                url = first.split(": ", 1)[1]
                break
        except (FileNotFoundError, IndexError):
            pass
        time.sleep(0.05)
    if not url:
        if proc.poll() is None:
            proc.terminate()
        print(f"team-ui: server failed to start; see {LOG_FILE}", file=sys.stderr)
        return 1
    PID_FILE.write_text(f"{proc.pid}\n", encoding="utf-8")
    URL_FILE.write_text(f"{url}\n", encoding="utf-8")
    print(f"ClawTeam metadata board started: {url}")
    return 0


def status() -> int:
    current = tracked()
    if current:
        print(f"running {current[1]} (pid {current[0]})")
        return 0
    print("stopped")
    return 1


def stop() -> int:
    current = tracked()
    if not current:
        print("ClawTeam metadata board is not running")
        return 0
    os.kill(current[0], signal.SIGTERM)
    print(f"Stopped ClawTeam metadata board (pid {current[0]})")
    return 0


def main() -> int:
    command = sys.argv[1] if len(sys.argv) > 1 else "start"
    if len(sys.argv) > 2 or command not in {"start", "status", "stop"}:
        print("usage: team-ui [start|status|stop]", file=sys.stderr)
        return 64
    return {"start": start, "status": status, "stop": stop}[command]()


if __name__ == "__main__":
    raise SystemExit(main())
