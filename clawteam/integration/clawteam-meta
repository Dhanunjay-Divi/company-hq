#!/usr/bin/env python3
"""Allowlisted ClawTeam CLI facade for metadata coordination only."""

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
from runtime_config import clawteam_data_dir, python_executable
os.umask(0o077)
desired_python = python_executable()
if Path(sys.executable).resolve() != desired_python and os.environ.get("COMPANY_HQ_REEXEC") != "1":
    env = os.environ.copy(); env["COMPANY_HQ_REEXEC"] = "1"
    os.execve(str(desired_python), [str(desired_python), str(Path(__file__).resolve()), *sys.argv[1:]], env)
data_dir = clawteam_data_dir().resolve()
data_dir.mkdir(parents=True, exist_ok=True)
os.environ["CLAWTEAM_DATA_DIR"] = str(data_dir)
os.environ["CLAWTEAM_TRANSPORT"] = "file"
os.environ.setdefault("CLAWTEAM_USER", "local")
os.environ.pop("CLAWTEAM_REDIS_URL", None)

from task_authority import install_task_authority
install_task_authority()

from clawteam.events.bus import EventBus  # noqa: E402
from clawteam.events import global_bus  # noqa: E402
from clawteam.team import redis_wakeup  # noqa: E402

global_bus._bus = EventBus()
global_bus._initialized = True
redis_wakeup.publish_wakeup = lambda *args, **kwargs: False

ALLOWED = {
    ("team", "discover"), ("team", "status"), ("team", "add-member"),
    ("inbox", "send"), ("inbox", "broadcast"), ("inbox", "receive"),
    ("inbox", "peek"), ("inbox", "log"),
    ("task", "create"), ("task", "get"), ("task", "update"),
    ("task", "list"), ("task", "stats"),
    ("board", "show"), ("board", "overview"), ("board", "update"),
}


def create_team(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="clawteam-meta team create")
    parser.add_argument("name")
    parser.add_argument("leader")
    parser.add_argument("--leader-id", required=True)
    parser.add_argument("--description", default="")
    parser.add_argument("--agent-type", default="overall-head")
    args = parser.parse_args(argv)
    from clawteam.team.manager import TeamManager
    team = TeamManager.create_team(
        name=args.name,
        leader_name=args.leader,
        leader_id=args.leader_id,
        description=args.description,
        user=os.environ["CLAWTEAM_USER"],
        leader_agent_type=args.agent_type,
    )
    print(team.model_dump_json(indent=2, by_alias=True))
    return 0


def main() -> int:
    args = sys.argv[1:]
    if args[:2] == ["team", "create"]:
        return create_team(args[2:])
    pair = tuple(args[:2])
    if len(pair) != 2 or pair not in ALLOWED:
        allowed = ", ".join(" ".join(item) for item in sorted(ALLOWED | {("team", "create")}))
        print(f"clawteam-meta: command disabled; metadata-only commands: {allowed}", file=sys.stderr)
        return 64
    from clawteam.cli.commands import app
    sys.argv = ["clawteam-meta", *args]
    app()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
